{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Markdown Viewer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "include_globs": [
        "*.md",
        "*.MD",
        "*.markdown",
        "*.mdown",
        "*.mkd",
        "*.mdx",
        "*.md?*",
        "*.md#*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "vendor/katex/*",
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}